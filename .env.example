# Where contact-form messages are delivered.
#
# Any service that accepts a JSON POST works — Formspree, Zapier, Make, n8n,
# a Slack incoming webhook, or your own handler. The body posted is:
#   { name, email, phone, company, subject, message, to, submittedFrom }
#
# Leave this unset and /api/contact answers 501, so the form falls back to
# opening the visitor's mail client with the message prefilled. It still
# works — it just relies on them pressing send.
CONTACT_WEBHOOK_URL=""

# The public origin this deploy is served from, with no trailing slash.
# Everything canonical hangs off it: metadataBase, the sitemap and robots.txt.
# Leave unset on the live site; set it on staging.
#   NEXT_PUBLIC_SITE_URL="https://staging.databasebuilder.com"
NEXT_PUBLIC_SITE_URL=""

# Set to 1 on any deploy that is not the live site. robots.txt then disallows
# everything and every page carries <meta name="robots" content="noindex">,
# so a staging copy cannot compete with databasebuilder.com in search.
NEXT_PUBLIC_NOINDEX=""
